{
  "name": "Pack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "default": 100
    },
    "image_url": {
      "type": "string"
    },
    "background_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "bazaar_only": {
      "type": "boolean",
      "default": false
    },
    "release_date": {
      "type": "string",
      "format": "date-time"
    },
    "daily_blook_id": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "font_family": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "enum": [
        "icecreamet",
        "pokemon"
      ],
      "default": "icecreamet"
    },
    "locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "cost"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}