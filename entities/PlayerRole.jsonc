{
  "name": "PlayerRole",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "player",
        "helper",
        "moderator",
        "admin",
        "co-owner",
        "executive-manager",
        "owner",
        "biggie"
      ],
      "default": "player"
    }
  },
  "required": [
    "user_id",
    "role"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}