{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "mentions": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "enum": [
        "icecreamet",
        "pokemon"
      ],
      "default": "icecreamet"
    },
    "channel": {
      "type": "string",
      "default": "global"
    },
    "discord_msg_id": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_username": {
      "type": "string"
    },
    "reply_to_content": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.is_system": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}