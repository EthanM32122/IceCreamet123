{
  "name": "GTBLobby",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "ended"
      ],
      "default": "waiting"
    },
    "players": {
      "type": "string"
    },
    "current_blook_id": {
      "type": "string"
    },
    "current_blook_name": {
      "type": "string"
    },
    "current_blook_image": {
      "type": "string"
    },
    "round": {
      "type": "number",
      "default": 0
    },
    "round_active": {
      "type": "boolean",
      "default": false
    },
    "round_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "winner_id": {
      "type": "string"
    },
    "winner_username": {
      "type": "string"
    }
  },
  "required": [
    "host_id"
  ],
  "rls": {
    "create": {
      "data.host_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}