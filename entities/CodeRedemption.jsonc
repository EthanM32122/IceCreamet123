{
  "name": "CodeRedemption",
  "type": "object",
  "properties": {
    "code_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "prize_type": {
      "type": "string"
    },
    "prize_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}