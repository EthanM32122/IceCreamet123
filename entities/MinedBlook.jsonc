{
  "name": "MinedBlook",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "blook_id": {
      "type": "string"
    },
    "blook_name": {
      "type": "string"
    },
    "blook_image_url": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "hourly_rate": {
      "type": "number",
      "default": 0
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "blook_id",
    "hourly_rate"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}