{
  "name": "Auction",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_username": {
      "type": "string"
    },
    "blook_id": {
      "type": "string"
    },
    "blook_name": {
      "type": "string"
    },
    "blook_image_url": {
      "type": "string"
    },
    "blook_rarity": {
      "type": "string"
    },
    "starting_price": {
      "type": "number"
    },
    "current_bid": {
      "type": "number",
      "default": 0
    },
    "current_bidder_id": {
      "type": "string"
    },
    "current_bidder_username": {
      "type": "string"
    },
    "bid_count": {
      "type": "number",
      "default": 0
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "claimed",
        "cancelled"
      ],
      "default": "active"
    },
    "game": {
      "type": "string",
      "enum": [
        "icecreamet",
        "pokemon"
      ],
      "default": "icecreamet"
    },
    "is_shiny": {
      "type": "boolean",
      "default": false
    },
    "is_event": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "seller_id",
    "blook_id",
    "starting_price",
    "end_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}